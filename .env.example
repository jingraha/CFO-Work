# Optional local overrides. Local development works without this file.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Required before any production deployment. Generate a high-entropy value.
BETTER_AUTH_SECRET=

# Optional local database path. Defaults to .data\cfo-os.
CFO_DATABASE_PATH=

# The seed command uses these local credentials when set.
CFO_DEMO_EMAIL=cfo@example.com
CFO_DEMO_PASSWORD=local-demo-only

# Keep disabled in production. Local member accounts are created by a CFO admin.
CFO_ALLOW_SIGNUP=false
